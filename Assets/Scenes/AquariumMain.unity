  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Garden eels (Heteroconger hassi) may be small compared to other eel species
    (only half an inch in diameter), but what they lack in size, they make up for
    in muscle. H. hassi uses its stiff, muscular tail to dig into the sandy seafloor,
    then secretes a slimy mucus that acts like cement to keep its burrow from caving
    in. When alarmed, garden eels withdraw tail-first into the holes they\u2019ve
    created in order to avoid predators."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
